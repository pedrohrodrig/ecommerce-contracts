{
  "name": "ecommerce-contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Contratos HTTP (OpenAPI) do e-commerce da ótica",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "redocly lint && oxlint --deny-warnings --no-error-on-unmatched-pattern",
    "bundle": "redocly bundle openapi/openapi.yaml -o dist/openapi.yaml",
    "build:docs": "redocly build-docs openapi/openapi.yaml -o dist/docs.html",
    "generate": "openapi-typescript",
    "check:generated": "pnpm generate && git diff --exit-code -- generated/",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@redocly/cli": "^2.77.0",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "typescript": "^5.9.3"
  }
}
