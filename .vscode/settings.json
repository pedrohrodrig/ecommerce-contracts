{
  // Formata com o Prettier do projeto (mesma versão e regras do CI).
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "prettier.requireConfig": true,
  "files.eol": "\n",

  // Arquivos gerados não devem ser editados.
  "files.readonlyInclude": {
    "generated/**": true
  }
}
